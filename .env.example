# Copy to .env beside docker-compose.yaml and fill in.
# Every value is required -- compose fails at startup naming any that are missing.

# Pi-hole admin password.
FTLCONF_webserver_api_password=

# Where Pi-hole forwards queries. Must point at the unbound container, which is
# published on the host loopback at 5053. The image's built-in default is a
# public resolver, which bypasses unbound entirely.
FTLCONF_dns_upstreams=127.0.0.1#5053

TZ=Etc/UTC

# dnsmasq directives, semicolon separated.
#
# edns-packet-max must stay. It matches unbound's edns-buffer-size so that large
# replies are not fragmented.
#
# Local DNS records go after it. A single address= line covers a subdomain and
# everything below it, which is enough to point every internal service at one
# reverse proxy:
#
#   edns-packet-max=1232;address=/home.example.com/192.168.1.100
#
FTLCONF_misc_dnsmasq_lines=edns-packet-max=1232
